{
  "name": "aegisguard/security",
  "description": "Development tooling for the AegisGuard Security WordPress plugin.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "squizlabs/php_codesniffer": "^3.13.6",
    "wp-coding-standards/wpcs": "^3.4.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1.8"
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist .",
    "compat": "phpcs --standard=PHPCompatibilityWP --extensions=php --runtime-set testVersion 7.4- ."
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
